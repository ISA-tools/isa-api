<file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/output/BII-S-3-synth/BII-S-3-isa-rdf-obo-v3.json#process/e309fcf7-a023-4365-8b77-9d9603852ebe> a obo:BFO_0000015 ;
    obo:BFO_0000062 <file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/output/BII-S-3-synth/BII-S-3-isa-rdf-obo-v3.json#process/de85eb93-5952-4698-9d4d-eb38dfca284e> ;
