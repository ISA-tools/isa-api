[] ns1:isatermshas_part [ a ns1:isatermspublication ;
            ns1:isatermsauthor "Jacob A. Rasmussen, Martin Hansen, Harald Sveier, Morten T. Limborg"@en ;
            ns1:isatermsdoi ""@en ;
            ns1:isatermspublication_status <file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/MTBLS4381_183928_compressed_files/isa-rdf.json#ontology_annotation/4f2ec0c1-8d26-463c-8de2-54623be8e617> ;
            ns1:isatermspubmed_identifier ""@en ;
            ns1:isatermstitle "Metabolomics to elucidate the effects of novel sustainable feed additives in the feed of farmed salmon"@en ],
