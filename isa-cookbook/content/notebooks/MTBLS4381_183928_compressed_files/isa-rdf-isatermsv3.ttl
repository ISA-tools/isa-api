<file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/MTBLS4381_183928_compressed_files/isa-rdf.json#ontology_annotation/fff27a9f-c31a-4496-be0a-82658e63dd93> a ns2:descriptor_value ;
