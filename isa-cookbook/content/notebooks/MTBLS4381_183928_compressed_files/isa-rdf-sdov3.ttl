<file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/MTBLS4381_183928_compressed_files/isa-rdf.json#protocol_parameter/0342c543-cdd8-435d-8f8d-a59f21df6aad> a <http://schema.orgPropertyValue/> ;
    ns1:schema.orgname <file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/MTBLS4381_183928_compressed_files/isa-rdf.json#ontology_annotation/ca5412ce-7daf-4935-afea-7c32e5db673a> .

<file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/MTBLS4381_183928_compressed_files/isa-rdf.json#protocol_parameter/11e3326c-ee00-4964-9643-84e2664dfbc0> a <http://schema.orgPropertyValue/> ;
    ns1:schema.orgname <file:///Users/oerc0042/NDocuments/git/isa-api/isa-cookbook/content/notebooks/MTBLS4381_183928_compressed_files/isa-rdf.json#ontology_annotation/b28a95dd-1343-4b0c-86d0-99bb85ad7c38> .

